# Application
APP_NAME=ServiceConnect
DEBUG=False
API_V1_PREFIX=/api/v1

# Database (asyncpg for async, psycopg2 sync URL for Celery)
DATABASE_URL=postgresql+asyncpg://sc_user:sc_password@localhost:5432/serviceconnect
SYNC_DATABASE_URL=postgresql+psycopg2://sc_user:sc_password@localhost:5432/serviceconnect
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS_PER_HOUR=5
DOORSTEP_OTP_LENGTH=4

# SMS Provider (msg91 | twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLATFORM_COMMISSION_PERCENT=20.0

# Admin IP allowlist (SVC-75). Empty = no restriction (dev-safe). See
# backend/ADMIN.md for how to populate in staging / prod.
ADMIN_ALLOWED_IPS=
ADMIN_TRUST_FORWARDED_FOR=false

# Firebase
FCM_CREDENTIALS_PATH=

# Storage (S3 / MinIO)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Booking
BOOKING_REQUEST_TIMEOUT_SECONDS=120
CANCELLATION_FEE=50.0

# Encryption key for PII fields (AES-256 — 32 bytes, base64-encoded or hex)
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

# E2E test OTP bypass (SVC-52). Empty in dev/prod. In staging:
#   E2E_TEST_PHONES=+919999900001,+919999900002
#   E2E_TEST_OTP=123456
# Hard-refuses to activate when ENVIRONMENT=production. Rate limiting still
# applies to bypass phones — it's not an abuse exemption.
E2E_TEST_PHONES=
E2E_TEST_OTP=

# Observability (SVC-46)
# Deployment tag propagated to Sentry + log records: dev | staging | production
ENVIRONMENT=dev
# Empty = Sentry disabled. Grab DSN from Sentry project settings.
SENTRY_DSN=
# Perf tracing sample rate. Keep low in prod (billing); bump for debug sessions.
SENTRY_TRACES_SAMPLE_RATE=0.0
# JSON logs in staging/prod (CloudWatch / Loki parseable); false for dev console.
LOG_JSON=false
LOG_LEVEL=INFO

# Application
APP_NAME=ServiceConnect
DEBUG=False
API_V1_PREFIX=/api/v1

# Database (asyncpg for async, psycopg2 sync URL for Celery)
DATABASE_URL=postgresql+asyncpg://sc_user:sc_password@localhost:5432/serviceconnect
SYNC_DATABASE_URL=postgresql+psycopg2://sc_user:sc_password@localhost:5432/serviceconnect
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6380/0

# Celery — broker + result backend. Blank = fall back to REDIS_URL (dev
# behaviour). Beta runs on SQS as of the 2026-08-25 cutover — see PR
# #<TBD> — because kombu-Redis's fanout + control-channel chatter alone
# was ~60k Redis commands/day even after PR #131 and #134 tuning.
#
# To run against SQS: set CELERY_BROKER_URL=sqs:// AND CELERY_SQS_QUEUE_URL
# to the full https://sqs.<region>.amazonaws.com/<account>/<queue> URL, and
# grant the container's IAM role sqs:SendMessage/ReceiveMessage/DeleteMessage/
# GetQueueUrl/GetQueueAttributes/ChangeMessageVisibility on that queue.
# kombu-SQS uses boto3 credentials (already a dep) — no PyCURL needed.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND_URL=
CELERY_SQS_QUEUE_URL=
# boto3 also honours this — set explicitly in container env for prod.
AWS_REGION=

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS_PER_HOUR=5
DOORSTEP_OTP_LENGTH=4

# SMS Provider (msg91 | twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLATFORM_COMMISSION_PERCENT=20.0
# Razorpay Payments webhook secret (Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX (payouts) — separate product, separate virtual account + webhook secret
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# SVC-161: SMS-a-link on /download. Off = endpoint returns 501 and
# frontend falls back to QR-code-only. Turn on ONLY after a dedicated
# MSG91 template is approved (~1-3 business days).
SMS_DOWNLOAD_LINK_ENABLED=false

# CORS allowed origins (B4). Comma-separated. Empty falls back to the
# dev-friendly default in config.py (localhost + Capacitor + prod web).
# Staging / prod should set explicitly:
#   staging: https://app.staging.serviceconnect.in,capacitor://localhost,...
#   prod:    https://app.serviceconnect.in,capacitor://localhost,...
# Never use `*` — allow_credentials=True + wildcard is a spec violation.
CORS_ALLOWED_ORIGINS=

# Admin IP allowlist (SVC-75). Empty = no restriction (dev-safe). See
# backend/ADMIN.md for how to populate in staging / prod.
ADMIN_ALLOWED_IPS=
ADMIN_TRUST_FORWARDED_FOR=false

# Firebase / FCM — path to the service-account JSON. See FIREBASE.md
# for how to generate. Local dev: point at the file downloaded via
# `gcloud iam service-accounts keys create`. Production: the file lives
# at whatever path the Fargate task def points at, populated from
# SSM /sc/{env}/FCM_CREDENTIALS_JSON (base64) at container start.
#
# Must be an ABSOLUTE path — `~` is not expanded, it is passed to
# credentials.Certificate() verbatim and fails as a literal filename.
#
# Empty = pushes are LOGGED instead of sent, so the app runs without
# Firebase credentials on dev machines and in CI. In production, empty
# raises — silently dropping every notification there would be
# invisible and untraceable. Left empty on purpose: a placeholder path
# looks configured, skips the log-only path, and fails inside
# firebase-admin with a file-not-found instead.
FCM_CREDENTIALS_PATH=

# Storage (S3 / MinIO)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Booking
BOOKING_REQUEST_TIMEOUT_SECONDS=120
CANCELLATION_FEE=50.0

# Encryption key for PII fields (AES-256 — 32 bytes, base64-encoded or hex)
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

# E2E test OTP bypass (SVC-52). Empty in dev/prod. In staging:
#   E2E_TEST_PHONES=+919999900001,+919999900002
#   E2E_TEST_OTP=123456
# Hard-refuses to activate when ENVIRONMENT=production. Rate limiting still
# applies to bypass phones — it's not an abuse exemption.
E2E_TEST_PHONES=
E2E_TEST_OTP=

# Observability (SVC-46)
# Deployment tag propagated to Sentry + log records: dev | staging | production
ENVIRONMENT=dev
# Empty = Sentry disabled. Grab DSN from Sentry project settings.
SENTRY_DSN=
# Perf tracing sample rate. Keep low in prod (billing); bump for debug sessions.
SENTRY_TRACES_SAMPLE_RATE=0.0
# JSON logs in staging/prod (CloudWatch / Loki parseable); false for dev console.
LOG_JSON=false
LOG_LEVEL=INFO

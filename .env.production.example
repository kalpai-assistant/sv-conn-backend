# .env for PRODUCTION (ap-south-1, VPC 10.20.0.0/16). Real values live in AWS
# SSM under /sc/production/*; this file exists so a new dev sees the shape.
#
# NEVER commit real production values. NEVER share this file with real values
# via chat / email / screenshot. Rotate via the runbook in SECRETS.md (WIP).
#
# See backend/INFRA.md for the topology this maps to.

# Application
APP_NAME=ServiceConnect
DEBUG=False
API_V1_PREFIX=/api/v1

# Database — RDS production (db.t4g.medium, Multi-AZ, PostGIS)
DATABASE_URL=postgresql+asyncpg://sc_admin:CHANGE_ME@sc-prod-db.xxxx.ap-south-1.rds.amazonaws.com:5432/serviceconnect_prod
SYNC_DATABASE_URL=postgresql+psycopg2://sc_admin:CHANGE_ME@sc-prod-db.xxxx.ap-south-1.rds.amazonaws.com:5432/serviceconnect_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis — ElastiCache production (cache.t4g.small, Multi-AZ + failover)
REDIS_URL=rediss://sc-prod-redis.xxxx.ap-south-1.cache.amazonaws.com:6379/0

# JWT — must be different from staging. Rotated on schedule per SECRETS.md.
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_PROD_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS_PER_HOUR=5
DOORSTEP_OTP_LENGTH=4

# SMS — MSG91 live credentials (real deliverability)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=CHANGE_ME_PROD_MSG91
MSG91_TEMPLATE_ID=CHANGE_ME
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay — LIVE keys (rzp_live_...). Merchant KYC must be approved (SC-73).
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_COMMISSION_PERCENT=20.0

# Firebase — production FCM project (separate Firebase project from staging)
FCM_CREDENTIALS_PATH=/etc/sc/fcm-production.json

# Storage — production S3 bucket with Object Lock + Glacier lifecycle
S3_BUCKET_NAME=sc-prod-kyc
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps — production key with billing cap $200/mo (revisit at Growth tier)
GOOGLE_MAPS_API_KEY=CHANGE_ME_PROD_GMAPS

# Booking
BOOKING_REQUEST_TIMEOUT_SECONDS=120
CANCELLATION_FEE=50.0

# Encryption — must differ from staging. Losing this key = losing all KYC PII.
# Backed up in KMS + noted in SECRETS.md.
ENCRYPTION_KEY=CHANGE_ME_PROD_32BYTE_KEY

# Admin IP allowlist (SVC-75) — office IPs + Vipul's VPN only. No home IPs.
# Behind ALB, so trust_forwarded=true.
ADMIN_ALLOWED_IPS=203.0.113.4/32,198.51.100.0/24
ADMIN_TRUST_FORWARDED_FOR=true

# Sentry (SC-46, when it lands)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/production
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# .env for STAGING (ap-south-1, VPC 10.10.0.0/16). Real values live in AWS SSM
# under /sc/staging/*; this file exists so a new dev sees the shape.
#
# See backend/INFRA.md for the topology this maps to.

# Application
APP_NAME=ServiceConnect (Staging)
DEBUG=False
API_V1_PREFIX=/api/v1

# Database — RDS staging (db.t4g.small, single-AZ, PostGIS)
DATABASE_URL=postgresql+asyncpg://sc_admin:CHANGE_ME@sc-staging-db.xxxx.ap-south-1.rds.amazonaws.com:5432/serviceconnect_staging
SYNC_DATABASE_URL=postgresql+psycopg2://sc_admin:CHANGE_ME@sc-staging-db.xxxx.ap-south-1.rds.amazonaws.com:5432/serviceconnect_staging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis — ElastiCache staging (cache.t4g.micro)
REDIS_URL=rediss://sc-staging-redis.xxxx.ap-south-1.cache.amazonaws.com:6379/0

# JWT — generated at env provision time, rotated per SECRETS.md schedule
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP — same as dev
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS_PER_HOUR=5
DOORSTEP_OTP_LENGTH=4

# SMS — staging uses MSG91 test credentials (deliverable but flagged as test)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=CHANGE_ME_STAGING_MSG91
MSG91_TEMPLATE_ID=CHANGE_ME
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay — test-mode keys (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_COMMISSION_PERCENT=20.0

# Firebase — staging FCM project
FCM_CREDENTIALS_PATH=/etc/sc/fcm-staging.json

# Storage — staging S3 bucket
S3_BUCKET_NAME=sc-staging-kyc
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps — staging key with billing cap $50/mo
GOOGLE_MAPS_API_KEY=CHANGE_ME_STAGING_GMAPS

# Booking
BOOKING_REQUEST_TIMEOUT_SECONDS=120
CANCELLATION_FEE=50.0

# Encryption — same key across staging instances (rotated with the app, not
# per-instance). Different from prod.
ENCRYPTION_KEY=CHANGE_ME_STAGING_32BYTE_KEY

# Admin IP allowlist (SVC-75) — office egress + VPN
ADMIN_ALLOWED_IPS=203.0.113.4/32,198.51.100.0/24
ADMIN_TRUST_FORWARDED_FOR=true

# Sentry (SC-46, when it lands)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/staging
# SENTRY_ENVIRONMENT=staging
